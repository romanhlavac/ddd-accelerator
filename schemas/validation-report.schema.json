{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddda.local/schemas/validation-report.schema.json",
  "title": "DDDA platform validation report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "validation_id",
    "status",
    "started_at",
    "completed_at",
    "source",
    "package",
    "suites"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "validation_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "repository",
        "commit"
      ],
      "properties": {
        "kind": {
          "enum": [
            "pr",
            "release",
            "working-tree"
          ]
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "pr": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "package": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9A-Fa-f]{64}$"
            }
          }
        }
      ]
    },
    "workspace": {
      "type": [
        "string",
        "null"
      ]
    },
    "miro_board_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "miro": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "board_id",
        "board_url",
        "workspace",
        "managed_artifacts",
        "mapping",
        "sync_state",
        "idempotence",
        "cleanup",
        "diagnostics"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_RUN"
          ]
        },
        "board_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "board_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "workspace": {
          "type": [
            "string",
            "null"
          ]
        },
        "managed_artifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mapping": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "path",
            "verified_count"
          ],
          "properties": {
            "status": {
              "enum": [
                "PASS",
                "FAIL",
                "NOT_RUN"
              ]
            },
            "path": {
              "type": [
                "string",
                "null"
              ]
            },
            "verified_count": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "sync_state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "path",
            "verified_count"
          ],
          "properties": {
            "status": {
              "enum": [
                "PASS",
                "FAIL",
                "NOT_RUN"
              ]
            },
            "path": {
              "type": [
                "string",
                "null"
              ]
            },
            "verified_count": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "idempotence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "verification",
            "board_id_stable",
            "item_count_before",
            "item_count_after",
            "second_run_create_board_operations",
            "second_run_mutating_operations"
          ],
          "properties": {
            "status": {
              "enum": [
                "PASS",
                "FAIL",
                "NOT_RUN"
              ]
            },
            "verification": {
              "type": [
                "string",
                "null"
              ]
            },
            "board_id_stable": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "item_count_before": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "item_count_after": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "second_run_create_board_operations": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "second_run_mutating_operations": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "cleanup": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "attempted_at",
            "completed_at",
            "error",
            "reason"
          ],
          "properties": {
            "state": {
              "enum": [
                "preserved",
                "deleted",
                "cleanup_failed",
                "not_created"
              ]
            },
            "attempted_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "completed_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "error": {
              "type": [
                "string",
                "null"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "cleanup": {
                "properties": {
                  "state": {
                    "enum": [
                      "deleted",
                      "preserved"
                    ]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "board_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cleanup": {
                "properties": {
                  "state": {
                    "const": "cleanup_failed"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "cleanup": {
                "properties": {
                  "error": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "idempotence": {
                "properties": {
                  "status": {
                    "const": "PASS"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "idempotence": {
                "properties": {
                  "board_id_stable": {
                    "const": true
                  },
                  "second_run_create_board_operations": {
                    "const": 0
                  },
                  "second_run_mutating_operations": {
                    "const": 0
                  }
                }
              }
            }
          }
        }
      ]
    },
    "suites": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status",
          "duration_ms"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "SKIP"
            ]
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          },
          "details": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
