{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddda.local/schemas/validation-report.schema.json",
  "title": "DDDA platform validation report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "validation_id",
    "status",
    "started_at",
    "completed_at",
    "source",
    "package",
    "suites"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "validation_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["PASS", "FAIL"] },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repository", "commit"],
      "properties": {
        "kind": { "enum": ["pr", "release", "working-tree"] },
        "repository": { "type": "string", "minLength": 1 },
        "pr": { "type": ["integer", "null"], "minimum": 1 },
        "branch": { "type": ["string", "null"] },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "package": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" }
          }
        }
      ]
    },
    "workspace": { "type": ["string", "null"] },
    "miro_board_id": { "type": ["string", "null"] },
    "suites": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "duration_ms"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "enum": ["PASS", "FAIL", "SKIP"] },
          "duration_ms": { "type": "integer", "minimum": 0 },
          "details": { "type": ["string", "null"] }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
