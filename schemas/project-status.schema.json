{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddda.local/schemas/project-status.schema.json",
  "title": "DDDA Project Status Report",
  "type": "object",
  "required": ["status_report"],
  "properties": {
    "status_report": {
      "type": "object",
      "required": ["project_root", "current_stage", "next_gate", "gates", "next_actions", "chat_prompt"],
      "properties": {
        "project_root": {"type": "string"},
        "current_stage": {"type": "string"},
        "next_gate": {"pattern": "^G[1-8]$"},
        "gates": {"type": "array"},
        "next_actions": {"type": "array", "items": {"type": "string"}},
        "chat_prompt": {"type": "string"}
      }
    }
  }
}
