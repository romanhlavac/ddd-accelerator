{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddda.local/schemas/ingestion-manifest.schema.json",
  "title": "DDDA ingestion manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest"],
  "properties": {
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "example_id", "project_intake", "files"],
      "properties": {
        "schema_version": { "const": 1 },
        "example_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "description": { "type": "string", "minLength": 1 },
        "project_intake": { "type": "string", "minLength": 1 },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "target", "role"],
            "properties": {
              "source": { "type": "string", "minLength": 1 },
              "target": { "type": "string", "minLength": 1 },
              "role": { "type": "string", "minLength": 1 },
              "required": { "type": "boolean", "default": true }
            }
          }
        }
      }
    }
  }
}
