{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddda.local/schemas/lifecycle-tailoring.schema.json",
  "title": "DDDA Lifecycle Tailoring",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "starter_method", "selected_stages", "extensions", "skipped_stages", "rule"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "profile": {"type": "string", "minLength": 1},
    "starter_method": {"const": "align-discover-decompose-strategize-connect-organize-define-code"},
    "selected_stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "gate", "required", "rationale"],
        "properties": {
          "stage": {"enum": ["align", "discover", "decompose", "strategize", "connect", "organize", "define", "code"]},
          "gate": {"pattern": "^G[1-8]$"},
          "required": {"type": "boolean"},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "extensions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "skipped_stages": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "rule": {"type": "string", "minLength": 1}
  }
}
