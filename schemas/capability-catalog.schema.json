{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddda.local/schemas/capability-catalog.schema.json",
  "title": "DDDA Capability Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "capabilities"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "purpose", "status", "starter_stages", "commands", "documentation", "tests", "miro"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$"},
          "name": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "status": {"enum": ["implemented", "partial", "planned"]},
          "starter_stages": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "commands": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "documentation": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "tests": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "miro": {"enum": ["none", "optional", "required"]}
        }
      }
    }
  }
}
