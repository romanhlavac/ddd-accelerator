{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddda.local/schemas/miro-scaffold.schema.json",
  "title": "DDDA Miro scaffold",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name_cs",
    "method_flow",
    "frames",
    "gate_states",
    "managed_placements",
    "zones",
    "traceability",
    "section_catalog",
    "visual_contract",
    "method_transitions",
    "stage_visual_templates",
    "example_templates"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name_cs": {
      "type": "string",
      "minLength": 1
    },
    "description_cs": {
      "type": "string"
    },
    "coordinate_system": {
      "type": "object",
      "properties": {
        "origin": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "stage_card": {
          "type": "object",
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "number",
              "minimum": 3000
            },
            "height": {
              "type": "number",
              "minimum": 1800
            }
          }
        },
        "work_frame": {
          "type": "object"
        },
        "horizontal_gap": {
          "type": "number"
        },
        "vertical_gap": {
          "type": "number"
        },
        "minimum_font_size": {
          "type": "object",
          "required": [
            "journey",
            "stage_example",
            "gate_legend",
            "workshop_guide",
            "workshop_example",
            "zone_header"
          ],
          "additionalProperties": {
            "type": "number",
            "minimum": 18
          }
        }
      }
    },
    "localization": {
      "type": "object"
    },
    "palette": {
      "type": "object"
    },
    "artifact_statuses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label_cs"
        ]
      }
    },
    "metadata_contract": {
      "type": "object"
    },
    "method_flow": {
      "type": "object",
      "required": [
        "direction",
        "stages"
      ],
      "properties": {
        "direction": {
          "enum": [
            "left_to_right",
            "top_to_bottom"
          ]
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "order",
              "title_cs",
              "x",
              "gate_after",
              "y",
              "work_frame",
              "visual_template",
              "cookbook_url",
              "method_url",
              "starter_reference_url"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "order": {
                "type": "integer"
              },
              "title_cs": {
                "type": "string"
              },
              "subtitle_cs": {
                "type": "string"
              },
              "x": {
                "type": "number"
              },
              "gate_after": {
                "type": "string"
              },
              "y": {
                "type": "number"
              },
              "work_frame": {
                "type": "string"
              },
              "visual_template": {
                "type": "string",
                "minLength": 1
              },
              "cookbook_url": {
                "type": "string",
                "format": "uri"
              },
              "method_url": {
                "type": "string",
                "format": "uri"
              },
              "starter_reference_url": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label_cs",
          "required_evidence"
        ]
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "stage",
          "title_cs",
          "x",
          "y",
          "width",
          "height",
          "scaffold",
          "purpose_cs"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          },
          "title_cs": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "height": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "mandatory": {
            "type": "boolean"
          },
          "repeat_for": {
            "type": "string"
          },
          "scaffold": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "purpose_cs": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "work",
              "overview"
            ]
          },
          "example_template": {
            "type": "string",
            "minLength": 1
          },
          "guide": {
            "type": "object",
            "required": [
              "start_cs",
              "outputs_cs",
              "cookbook_url",
              "method_url",
              "starter_reference_url"
            ],
            "properties": {
              "start_cs": {
                "type": "string",
                "minLength": 1
              },
              "outputs_cs": {
                "type": "string",
                "minLength": 1
              },
              "cookbook_url": {
                "type": "string",
                "format": "uri"
              },
              "method_url": {
                "type": "string",
                "format": "uri"
              },
              "starter_reference_url": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        }
      }
    },
    "cross_frame_links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "label_cs"
        ]
      }
    },
    "rendering": {
      "type": "object"
    },
    "gate_states": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label_cs",
          "symbol",
          "meaning_cs",
          "fill_color"
        ],
        "additionalProperties": true
      }
    },
    "managed_placements": {
      "type": "object",
      "required": [
        "project-charter",
        "ddda.current-status",
        "ddda.next-actions"
      ],
      "properties": {
        "project-charter": {
          "type": "object",
          "required": [
            "frame_id",
            "position",
            "width"
          ],
          "properties": {
            "frame_id": {
              "const": "control-center"
            },
            "position": {
              "type": "object",
              "required": [
                "x",
                "y"
              ],
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                }
              }
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "ddda.current-status": {
          "type": "object",
          "required": [
            "frame_id",
            "position",
            "width"
          ],
          "properties": {
            "frame_id": {
              "const": "control-center"
            },
            "position": {
              "type": "object",
              "required": [
                "x",
                "y"
              ],
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                }
              }
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "ddda.next-actions": {
          "type": "object",
          "required": [
            "frame_id",
            "position",
            "width"
          ],
          "properties": {
            "frame_id": {
              "const": "control-center"
            },
            "position": {
              "type": "object",
              "required": [
                "x",
                "y"
              ],
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                }
              }
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      },
      "additionalProperties": true
    },
    "zones": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title_cs",
          "stages",
          "x",
          "y",
          "width",
          "height"
        ]
      }
    },
    "traceability": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "starter_step",
          "stage",
          "gate",
          "frame",
          "managed_artifacts",
          "human_acceptance",
          "reference_visual",
          "cookbook_url",
          "method_url"
        ]
      }
    },
    "section_catalog": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "label_cs",
          "guidance_cs"
        ]
      }
    },
    "overlays": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "visual_contract": {
      "type": "object",
      "required": [
        "overview_frame",
        "minimum_stage_card_width",
        "minimum_stage_card_height",
        "minimum_work_frame_width",
        "minimum_work_frame_height",
        "minimum_frame_gap",
        "minimum_example_items",
        "guide_anchor",
        "require_cookbook_links",
        "require_method_links",
        "require_iteration_transitions",
        "developer_team_watermark",
        "minimum_stage_visual_items"
      ],
      "properties": {
        "overview_frame": {
          "type": "string",
          "minLength": 1
        },
        "minimum_stage_card_width": {
          "type": "number",
          "minimum": 3000
        },
        "minimum_stage_card_height": {
          "type": "number",
          "minimum": 1800
        },
        "minimum_work_frame_width": {
          "type": "number",
          "minimum": 3000
        },
        "minimum_work_frame_height": {
          "type": "number",
          "minimum": 2800
        },
        "minimum_frame_gap": {
          "type": "number",
          "minimum": 300
        },
        "minimum_example_items": {
          "type": "integer",
          "minimum": 3
        },
        "guide_anchor": {
          "const": "top_left"
        },
        "require_cookbook_links": {
          "const": true
        },
        "require_method_links": {
          "const": true
        },
        "require_iteration_transitions": {
          "type": "integer",
          "minimum": 2
        },
        "developer_team_watermark": {
          "const": "external_environment_not_rendered_by_ddda"
        },
        "minimum_stage_visual_items": {
          "type": "integer",
          "minimum": 4
        }
      }
    },
    "method_transitions": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "required": [
          "id",
          "from",
          "to",
          "x",
          "y",
          "symbol",
          "label_cs",
          "kind"
        ],
        "properties": {
          "kind": {
            "enum": [
              "forward",
              "feedback"
            ]
          }
        }
      }
    },
    "stage_visual_templates": {
      "type": "object",
      "minProperties": 8,
      "additionalProperties": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "required": [
                "id",
                "label_cs",
                "item_type",
                "shape",
                "x",
                "y",
                "width",
                "height",
                "fill_color",
                "font_size"
              ],
              "properties": {
                "font_size": {
                  "type": "number",
                  "minimum": 18
                },
                "width": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "height": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          }
        }
      }
    },
    "example_templates": {
      "type": "object",
      "minProperties": 8,
      "additionalProperties": {
        "type": "object",
        "required": [
          "title_cs",
          "items"
        ],
        "properties": {
          "title_cs": {
            "type": "string",
            "minLength": 1
          },
          "items": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "required": [
                "id",
                "label_cs",
                "item_type",
                "shape",
                "x",
                "y",
                "width",
                "height",
                "fill_color",
                "font_size"
              ],
              "properties": {
                "font_size": {
                  "type": "number",
                  "minimum": 18
                },
                "width": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "height": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
