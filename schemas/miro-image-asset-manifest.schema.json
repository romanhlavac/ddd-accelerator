{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddda.local/schemas/miro-image-asset-manifest.schema.json",
  "title": "DDDA managed Miro image transport manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "diagnostic_only",
    "board",
    "frames",
    "assets"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{2,80}$"
    },
    "diagnostic_only": {
      "type": "boolean"
    },
    "board": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "position",
          "geometry"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,60}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "$ref": "#/$defs/position"
          },
          "geometry": {
            "$ref": "#/$defs/frameGeometry"
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "usage",
          "source",
          "target"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,80}$"
          },
          "usage": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "board_id",
              "frame_id",
              "item_id",
              "title"
            ],
            "properties": {
              "board_id": {
                "type": "string",
                "minLength": 1
              },
              "frame_id": {
                "type": "string",
                "pattern": "^[0-9]+$"
              },
              "item_id": {
                "type": "string",
                "pattern": "^[0-9]+$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "expected_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "frame_id",
              "position",
              "width"
            ],
            "properties": {
              "frame_id": {
                "type": "string",
                "minLength": 1
              },
              "position": {
                "$ref": "#/$defs/position"
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "frameGeometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "diagnostic_only": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "assets": {
            "items": {
              "properties": {
                "source": {
                  "required": [
                    "expected_sha256"
                  ]
                }
              }
            }
          }
        }
      }
    }
  ]
}
