{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddda.example.invalid/schemas/release-source-recovery-ledger.schema.json",
  "title": "DDDA controlled release-source recovery ledger",
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "sha40": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recovered_commit_sha", "source_pr", "source_merge_commit_sha", "primary_cr"],
      "properties": {
        "recovered_commit_sha": {"$ref": "#/$defs/sha40"},
        "source_pr": {"type": "integer", "minimum": 1},
        "source_merge_commit_sha": {"$ref": "#/$defs/sha40"},
        "primary_cr": {"type": "integer", "minimum": 1}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "previous_release_tag", "entries"],
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "version": {"$ref": "#/$defs/semver"},
    "previous_release_tag": {"type": "string", "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    },
    "release_cut": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit_sha", "path", "source_blob_sha", "release_blob_sha", "version"],
      "properties": {
        "commit_sha": {"$ref": "#/$defs/sha40"},
        "path": {"const": "CHANGELOG.md"},
        "source_blob_sha": {"$ref": "#/$defs/sha40"},
        "release_blob_sha": {"$ref": "#/$defs/sha40"},
        "version": {"$ref": "#/$defs/semver"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": 1}}},
      "then": {"not": {"required": ["release_cut"]}}
    },
    {
      "if": {"properties": {"schema_version": {"const": 2}}},
      "then": {"required": ["release_cut"]}
    }
  ]
}
