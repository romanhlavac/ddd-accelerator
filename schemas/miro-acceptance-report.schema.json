{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddda.local/schemas/miro-acceptance-report.schema.json",
  "title": "DDDA Miro acceptance report",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "suite",
    "run_id",
    "status",
    "technical_sync_status",
    "layout_contract_status",
    "remote_layout_status",
    "render_contract_status",
    "render_contract_version",
    "platform_source_commit",
    "scaffold_sha256",
    "remote_item_count",
    "remote_content_digest",
    "review_team_selection_status",
    "utf8_status",
    "human_visual_acceptance_status",
    "overall_status",
    "miro",
    "gate_assertion",
    "report_created_at"
  ],
  "properties": {
    "suite": {
      "const": "project-steering"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "technical_sync_status": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_RUN"
      ]
    },
    "layout_contract_status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "utf8_status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "human_visual_acceptance_status": {
      "enum": [
        "PENDING",
        "PASS",
        "FAIL",
        "NOT_APPLICABLE"
      ]
    },
    "overall_status": {
      "enum": [
        "PENDING_HUMAN_REVIEW",
        "PASS",
        "PASS_OFFLINE",
        "FAIL"
      ]
    },
    "miro_board_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "miro_board_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "miro": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "board_id",
        "board_url",
        "workspace",
        "managed_artifacts",
        "mapping",
        "sync_state",
        "idempotence",
        "cleanup",
        "diagnostics"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_RUN"
          ]
        },
        "board_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "board_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "workspace": {
          "type": [
            "string",
            "null"
          ]
        },
        "managed_artifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mapping": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "path",
            "verified_count"
          ],
          "properties": {
            "status": {
              "enum": [
                "PASS",
                "FAIL",
                "NOT_RUN"
              ]
            },
            "path": {
              "type": [
                "string",
                "null"
              ]
            },
            "verified_count": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "sync_state": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "path",
            "verified_count"
          ],
          "properties": {
            "status": {
              "enum": [
                "PASS",
                "FAIL",
                "NOT_RUN"
              ]
            },
            "path": {
              "type": [
                "string",
                "null"
              ]
            },
            "verified_count": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "idempotence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "verification",
            "board_id_stable",
            "item_count_before",
            "item_count_after",
            "second_run_create_board_operations",
            "second_run_mutating_operations"
          ],
          "properties": {
            "status": {
              "enum": [
                "PASS",
                "FAIL",
                "NOT_RUN"
              ]
            },
            "verification": {
              "type": [
                "string",
                "null"
              ]
            },
            "board_id_stable": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "item_count_before": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "item_count_after": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "second_run_create_board_operations": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "second_run_mutating_operations": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          }
        },
        "cleanup": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "attempted_at",
            "completed_at",
            "error",
            "reason"
          ],
          "properties": {
            "state": {
              "enum": [
                "preserved",
                "deleted",
                "cleanup_failed",
                "not_created"
              ]
            },
            "attempted_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "completed_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "error": {
              "type": [
                "string",
                "null"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "cleanup": {
                "properties": {
                  "state": {
                    "enum": [
                      "deleted",
                      "preserved"
                    ]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "board_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cleanup": {
                "properties": {
                  "state": {
                    "const": "cleanup_failed"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "cleanup": {
                "properties": {
                  "error": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "idempotence": {
                "properties": {
                  "status": {
                    "const": "PASS"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "idempotence": {
                "properties": {
                  "board_id_stable": {
                    "const": true
                  },
                  "second_run_create_board_operations": {
                    "const": 0
                  },
                  "second_run_mutating_operations": {
                    "const": 0
                  }
                }
              }
            }
          }
        }
      ]
    },
    "gate_assertion": {
      "type": "object",
      "required": [
        "gate",
        "expected",
        "actual",
        "human_decision_created"
      ],
      "properties": {
        "gate": {
          "pattern": "^G[1-8]$"
        },
        "expected": {
          "type": "string"
        },
        "actual": {
          "type": [
            "string",
            "null"
          ]
        },
        "human_decision_created": {
          "const": false
        }
      }
    },
    "remote_layout_status": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_RUN"
      ]
    },
    "render_contract_status": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_RUN"
      ]
    },
    "render_contract_version": {
      "const": "REM-PR8-HVA-CC-002"
    },
    "platform_source_commit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "scaffold_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "remote_item_count": {
      "type": "integer",
      "minimum": 0
    },
    "remote_content_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "review_team_selection_status": {
      "enum": [
        "EXPLICIT_TEAM",
        "DEFAULT_TOKEN_TEAM",
        "NOT_APPLICABLE"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "technical_sync_status": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "render_contract_status": {
            "const": "PASS"
          },
          "platform_source_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "scaffold_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "remote_item_count": {
            "minimum": 250
          },
          "remote_content_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "human_visual_acceptance_status": {
            "enum": [
              "PENDING",
              "PASS",
              "FAIL"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "human_visual_acceptance_status": {
            "const": "PENDING"
          }
        }
      },
      "then": {
        "properties": {
          "overall_status": {
            "const": "PENDING_HUMAN_REVIEW"
          }
        }
      }
    }
  ]
}
