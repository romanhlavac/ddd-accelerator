{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddda.local/schemas/miro-artifact-registry-projection.schema.json",
  "title": "DDDA Miro Artifact Registry projection overlay",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "projection_id", "artifact_registry"],
  "properties": {
    "schema_version": {"const": 1},
    "projection_id": {"const": "REM-PR8-HVA-CC-012.2-gh-md-v1"},
    "artifact_registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode", "miro_item_id", "frame", "x", "y", "width", "font_size", "title", "content",
        "markdown_path", "github_url", "markdown_sha256", "source_of_truth_text",
        "expected_artifact_ids", "expected_total", "expected_lifecycle_counts",
        "expected_attention_count", "pages_backlog_issue"
      ],
      "properties": {
        "mode": {"const": "github_markdown"},
        "miro_item_id": {"type": "string", "pattern": "^[0-9]+$"},
        "frame": {"const": "control"},
        "x": {"type": "number"},
        "y": {"type": "number"},
        "width": {"type": "number", "exclusiveMinimum": 0},
        "font_size": {"enum": [18, 24, 36, 80, 144]},
        "title": {"const": "ARTIFACT HEALTH"},
        "content": {"type": "string", "minLength": 1},
        "markdown_path": {"const": "docs/artifacts/index.md"},
        "github_url": {"type": "string", "format": "uri", "pattern": "^https://github\\.com/"},
        "markdown_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_of_truth_text": {"const": "Git/YAML is source of truth"},
        "expected_artifact_ids": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "expected_total": {"type": "integer", "minimum": 1},
        "expected_lifecycle_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scaffold", "working", "candidate", "validated", "accepted", "superseded"],
          "properties": {
            "scaffold": {"type": "integer", "minimum": 0},
            "working": {"type": "integer", "minimum": 0},
            "candidate": {"type": "integer", "minimum": 0},
            "validated": {"type": "integer", "minimum": 0},
            "accepted": {"type": "integer", "minimum": 0},
            "superseded": {"type": "integer", "minimum": 0}
          }
        },
        "expected_attention_count": {"type": "integer", "minimum": 0},
        "pages_backlog_issue": {"const": 45}
      }
    }
  }
}
