{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddda.dev/schemas/recovery-transformation-decision.schema.json",
  "title": "DDDA Recovery Transformation Decision Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "repository",
    "pr",
    "source_sha",
    "candidate_package_sha256",
    "version",
    "reviewer",
    "decision",
    "decided_at",
    "rationale",
    "transformations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "recovery_transformation_decision"
    },
    "repository": {
      "type": "string",
      "pattern": "^[^/\\s]+/[^/\\s]+$"
    },
    "pr": {
      "type": "integer",
      "minimum": 1
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "candidate_package_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "const": "approve"
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "transformations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_pr",
          "primary_cr",
          "source_merge_commit_sha",
          "recovered_commit_sha",
          "path_decisions"
        ],
        "properties": {
          "source_pr": {
            "type": "integer",
            "minimum": 1
          },
          "primary_cr": {
            "type": "integer",
            "minimum": 1
          },
          "source_merge_commit_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "recovered_commit_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "path_decisions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "source_present",
                "source_blob_sha",
                "recovered_present",
                "recovered_blob_sha"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "source_present": {
                  "type": "boolean"
                },
                "source_blob_sha": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9a-f]{40}$"
                },
                "recovered_present": {
                  "type": "boolean"
                },
                "recovered_blob_sha": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9a-f]{40}$"
                }
              }
            }
          }
        }
      }
    }
  }
}
