{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ddda.local/schemas/project.schema.json",
  "title": "DDDA Project Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "ddda", "artifacts"],
  "properties": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type", "schema_version"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$"},
        "name": {"type": "string", "minLength": 1},
        "type": {"enum": ["portfolio-program", "greenfield-product", "legacy-modernization", "legacy-transformation", "integration-landscape", "purchased-product-adoption", "domain-discovery", "architecture-review", "operating-model-and-teams", "bounded-context-design"]},
        "type_alias": {"type": ["string", "null"], "enum": [null, "enterprise-transformation", "transformation-program", "greenfield-portfolio", "new-enterprise", "program-greenfield", "greenfield", "new-product", "modernization", "brownfield", "core-replacement", "business-transformation", "integration-review", "api-program", "cots", "saas-adoption", "package-implementation", "discovery", "strategic-ddd", "review", "architecture-assessment", "team-topologies", "org-design", "tactical-ddd", "bc-design"]},
        "schema_version": {"type": "integer", "minimum": 1},
        "language": {"enum": ["cs", "en"], "default": "cs"},
        "status": {"enum": ["proposed", "active", "paused", "archived"], "default": "active"}
      }
    },
    "ddda": {"type": "object", "additionalProperties": false, "required": ["repository", "required_ref", "lock_file"], "properties": {
      "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
      "required_ref": {"type": "string", "minLength": 1},
      "lock_file": {"const": "ddda.lock.yaml"}
    }},
    "miro": {"type": "object", "additionalProperties": false, "properties": {
      "board_id": {"type": ["string", "null"]},
      "board_id_env": {"type": ["string", "null"]},
      "access_token_env": {"type": "string", "minLength": 1},
      "team_id": {"type": ["string", "null"]},
      "team_id_env": {"type": ["string", "null"]},
      "project_id": {"type": ["string", "null"]},
      "project_id_env": {"type": ["string", "null"]},
      "workspace_area": {"type": ["string", "null"]},
      "scaffold": {"type": "string", "minLength": 1},
      "synchronization": {"enum": ["disabled", "yaml-to-miro", "miro-to-yaml", "bidirectional"]}
    }},
    "artifacts": {"type": "object", "additionalProperties": false, "required": ["canonical_source", "root"], "properties": {
      "canonical_source": {"enum": ["yaml", "miro"]},
      "root": {"type": "string", "minLength": 1},
      "mermaid_projection": {"type": "boolean", "default": true},
      "conflict_policy": {"enum": ["manual-review", "yaml-wins", "miro-wins"], "default": "manual-review"}
    }},
    "workflow": {"type": "object", "additionalProperties": false, "properties": {
      "profile": {"type": "string", "minLength": 1},
      "current_stage": {"type": "string", "minLength": 1},
      "completed_gates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
      "extensions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
    }},
    "classification": {"type": "object", "additionalProperties": false, "properties": {
      "data_sensitivity": {"enum": ["public", "internal", "confidential", "restricted"]},
      "contains_health_data": {"type": "boolean"}
    }},
    "owners": {"type": "object", "additionalProperties": {"type": ["string", "null"]}},
    "scope": {"type": "object", "additionalProperties": false, "properties": {
      "in": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
      "out": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
    }},
    "quality_attributes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}
